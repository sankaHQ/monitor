{
  "manifest_version": 3,
  "name": "Sanka Monitor — Sheets context",
  "description": "Recognize selected Google Sheets commands locally. Review in Sanka Monitor before sharing.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["storage", "scripting", "nativeMessaging"],
  "optional_host_permissions": ["https://docs.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
