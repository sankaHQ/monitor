{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanka Monitor",
  "identifier": "com.sanka.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sanka Monitor",
        "width": 720,
        "height": 540,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sankaHQ/monitor-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1ODRCQTE3QTczRTMwOTkKUldTWk1ENm5GN3FFZGZxalUxNk9xVXo5MlkzL1k3eVYwOEhJelZJQlAxWWtSZ0Erc2tDWUx1YngK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "sanka-monitor"
        ]
      }
    }
  }
}
