{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanka Monitor",
  "identifier": "com.sanka.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sanka Monitor",
        "width": 860,
        "height": 580,
        "center": true,
        "resizable": false,
        "visible": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 640,
          "height": 400
        },
        "appPosition": {
          "x": 190,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 450,
          "y": 210
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://release.sanka.com/monitor/latest.json",
        "https://github.com/sankaHQ/monitor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1ODRCQTE3QTczRTMwOTkKUldTWk1ENm5GN3FFZGZxalUxNk9xVXo5MlkzL1k3eVYwOEhJelZJQlAxWWtSZ0Erc2tDWUx1YngK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "sanka-monitor"
        ]
      }
    }
  }
}
