#!/bin/sh
# Runs as root after the .pkg installs /Applications/Sanka Monitor.app (device
# management). Opens the app in the menu bar for the person signed in at the
# console, so a deployment token in managed preferences connects the Mac at once.
# Nobody signed in (a fresh Mac at the login window): the login agent the .pkg
# installs in /Library/LaunchAgents opens it at their login.
user=$(/usr/bin/stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != "root" ] && [ "$user" != "loginwindow" ]; then
  uid=$(/usr/bin/id -u "$user")
  /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open -g -a "/Applications/Sanka Monitor.app" --args --background || true
fi
exit 0
